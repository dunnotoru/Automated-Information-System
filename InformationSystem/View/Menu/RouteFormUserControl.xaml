<UserControl x:Class="InformationSystem.View.Menu.RouteFormUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:InformationSystem.Converters"
             xmlns:menu="clr-namespace:InformationSystem.ViewModel.Menu"
             xmlns:validationRules="clr-namespace:InformationSystem.View.ValidationRules"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" d:DataContext="{d:DesignInstance menu:RouteMenuViewModel}">
    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverterKey"/>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <DockPanel >
            <Label DockPanel.Dock="Top" Content="Маршруты" Padding="10"
                   VerticalAlignment="Top" HorizontalAlignment="Center"/>
            <Button DockPanel.Dock="Bottom"
                    Content="Добавить" 
                    Margin="10"
                    MaxHeight="50" MinHeight="30"
                    MinWidth="50" MaxWidth="500"
                    Command="{Binding AddCommand}"/>
            <DataGrid ItemsSource="{Binding Items}" 
                      SelectedItem="{Binding SelectedItem}"
                      SelectionMode="Single"
                      Margin="10"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="auto"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <GroupBox Grid.Column="1" IsEnabled="{Binding IsRedactingEnabled}">
            <Grid DataContext="{Binding SelectedItem}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="246*"/>
                    <ColumnDefinition Width="233*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="300*"/>
                    <RowDefinition Height="50*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="10" Grid.Column="0" >
                    <DockPanel DockPanel.Dock="Top">
                        <Label DockPanel.Dock="Left" Padding="10" Content="Id" />
                        <TextBlock Text="{Binding Id}"/>
                    </DockPanel>
                    <Button DockPanel.Dock="Bottom"
                            Content="+"
                            MinWidth="20" MaxWidth="50"
                            MinHeight="20" MaxHeight="50"
                            HorizontalAlignment="Center"
                            Command="{Binding StationSelectionViewModel.UseStationCommand}"
                            />
                    <DockPanel>
                        <Label DockPanel.Dock="Top" Padding="5" Content="Все станции"/>
                        <ListView Margin="10"
                                  ItemsSource="{Binding StationSelectionViewModel.AllStations}"
                                  SelectedItem="{Binding StationSelectionViewModel.SelectedStationFromAll}"
                                  SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="auto" Header="Название" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Width="auto" Header="Адрес" DisplayMemberBinding="{Binding Address}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </DockPanel>

                <DockPanel Grid.Row="0" Margin="10" Grid.Column="1">
                    <DockPanel DockPanel.Dock="Top">
                        <Label DockPanel.Dock="Left" Padding="10" Content="Название" Target="NameTextBox"/>
                        <TextBox Margin="10" x:Name="NameTextBox">
                            <TextBox.Text>
                                <Binding Path="Name" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <validationRules:NotEmptyValidationRule/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" 
                        Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Margin="5 0" Content="-"
                                MinWidth="20" MaxWidth="50"
                                MinHeight="20" MaxHeight="50"
                                Command="{Binding StationSelectionViewModel.FreeStationCommand}"
                                />
                        <Button Margin="5 0" Content="Up"
                                Command="{Binding StationSelectionViewModel.MoveUpCommand}"
                                />
                        <Button Margin="5 0" Content="Down"
                                Command="{Binding StationSelectionViewModel.MoveDownCommand}"
                                />
                    </StackPanel>
                    <DockPanel>
                        <Label DockPanel.Dock="Top" Padding="5" Content="Станции в этом маршурте"/>
                        <ListView Margin="10" 
                                  ItemsSource="{Binding StationSelectionViewModel.UsedStations}" 
                                  SelectedItem="{Binding StationSelectionViewModel.SelectedStationFromUsed}"
                                  SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="auto" Header="Название" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Width="auto" Header="Адрес" DisplayMemberBinding="{Binding Address}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                </DockPanel>

                <Button Grid.Column="0" Grid.Row="1"
                        Command="{Binding SaveCommand}"
                        Margin="10" 
                        Content="Сохранить" 
                        MinWidth="50" MaxWidth="200"
                        MinHeight="20" MaxHeight="100"
                        >
                    <Button.IsEnabled>
                        <MultiBinding>
                            <MultiBinding.Converter>
                                <converters:MultiBoolConverter/>
                            </MultiBinding.Converter>
                            <MultiBinding.Bindings>
                                <Binding ElementName="NameTextBox" Path="(Validation.HasError)"/>
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
                <Button Grid.Column="1" Grid.Row="1" 
                        Margin="10"
                        Content="Удалить"
                        Command="{Binding RemoveCommand}"
                        MinWidth="50" MaxWidth="200"
                        MinHeight="20" MaxHeight="100"
                        />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
