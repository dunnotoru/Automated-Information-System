<UserControl x:Class="InformationSystem.View.Menu.StationMenuUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:InformationSystem.Converters"
             xmlns:validationRules="clr-namespace:InformationSystem.View.ValidationRules"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" >
    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverterKey"/>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" MinWidth="50"/>
            <ColumnDefinition Width="5*" MinWidth="50"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Bottom"
                    Content="Добавить" 
                    Margin="10"
                    Height="30"
                    Command="{Binding AddCommand}"/>
            <DockPanel>
                <Label DockPanel.Dock="Top" 
                       Content="Станции" HorizontalAlignment="Center"
                       Height="43" Width="86"/>
                <DataGrid ItemsSource="{Binding Items}" Margin="10"
                          SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn CanUserResize="False" Header="Id" Width="auto" Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="Название" Width="auto" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Адрес" Width="auto" Binding="{Binding Address}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DockPanel>

        <GroupBox Grid.Column="1" IsEnabled="{Binding IsRedactingEnabled}">
            <StackPanel DataContext="{Binding SelectedItem}" Margin="10">
                <DockPanel>
                    <Label DockPanel.Dock="Left" Content="Id"/>
                    <TextBlock Text="{Binding Id}"/>
                </DockPanel>
                <Label Content="Название"/>
                <TextBox x:Name="NameTextBox">
                    <TextBox.Text>
                        <Binding Path="Name" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <validationRules:NotEmptyValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <Label Content="Адрес"/>
                <TextBox x:Name="AddressTextBox">
                    <TextBox.Text>
                        <Binding Path="Address" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <validationRules:NotEmptyValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <Button Content="Сохранить"
                        Margin="10"
                        Command="{Binding SaveCommand}">

                    <Button.IsEnabled>
                        <MultiBinding>
                            <MultiBinding.Converter>
                                <converters:MultiBoolConverter/>
                            </MultiBinding.Converter>
                            <MultiBinding.Bindings>
                                <Binding ElementName="NameTextBox" Path="(Validation.HasError)"/>
                                <Binding ElementName="AddressTextBox" Path="(Validation.HasError)"/>
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>

                <Button Content="Удалить"
                        Margin="10"
                        Command="{Binding RemoveCommand}"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
